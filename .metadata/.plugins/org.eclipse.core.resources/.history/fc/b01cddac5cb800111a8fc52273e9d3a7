#include "cyBot_Scan.h"
#include "cyBot_uart.h"
#include "Timer.h"
#include "lcd.h"
#include "string.h"

// 227500 - right cal
// 1282750 - left cal
// for cyBOT 22

int main(void)
{
    timer_init();
    lcd_init();
    cyBOT_init_Scan(0b0111);
    cyBOT_SERVO_cal();
    cyBot_uart_init();
    right_calibration_value = 227500;
    left_calibration_value = 1282750;

    int i;
    int j;
    int k;
    int z;
    int letter;
    char message[50];
    double dist[91];
    char *header;
    cyBOT_Scan_t scan;

    for (i = 0; i <= 180; i += 2)
    {
        cyBOT_Scan(i, &scan);
        dist[i / 2] = scan.sound_dist;
    }

    while (1)
    {
        letter = cyBot_getByte();

        header = "Degrees\t\tDistance (cm)";

//    while (1)
//    {
        if (letter == 'm')
        {
            cyBot_sendByte('\r');
            cyBot_sendByte('\n');
            for (z = 0; z < strlen(header); z++)
            {
                cyBot_sendByte(header[z]);
            }
//
            for (j = 0; j < 91; j++)
            {
                sprintf(message, "%d\t\t%.1f", j * 2, dist[j]);
                cyBot_sendByte('\r');
                cyBot_sendByte('\n');
                for (k = 0; k < strlen(message); k++)
                {

                    cyBot_sendByte(message[k]);
                }
            }


        }
    }

    return 0;
}
