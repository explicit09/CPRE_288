//basicallt the move_forward function, I just made a new one just for lab 5. this will be in millimeteres, for precision, but feel free to change it
void drive_mm(oi_t *sensor_data, int mm)
{
    double sum = 0;
    int speed;

    if(mm> 0) speed = 100;
    else speed = -100;

    oi_setWheels(speed, speed);
    while (fabs(sum) < fabs((double) mm))
    {
        oi_update(sensor_data);
        sum += sensor_data->distance;
    }
    oi_setWheels(0, 0);
}

